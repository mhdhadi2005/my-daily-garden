PORT=3001
DB_PATH=./data/garden.db

# beehiiv (Settings → API)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_WEBHOOK_SECRET=

# WooCommerce (WooCommerce → Settings → Advanced → REST API)
WC_BASE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# WooCommerce purchase webhook signing secret (WooCommerce → Settings →
# Advanced → Webhooks → the secret you set when creating the webhook —
# different from the REST API keys above). Required in production or
# /webhooks/purchase rejects every request.
WC_WEBHOOK_SECRET=

# WordPress connector (must match MDG_SHARED_SECRET in the WPCode snippet —
# generate a long random string, treat it like a password)
WP_APP_SHARED_SECRET=

# Bearer token for admin job endpoints (POST /api/jobs/referrals). Any long
# random string. Without it those endpoints stay disabled.
ADMIN_API_SECRET=

# Nightly referral sweep. Hour is UTC (default 3 = 03:00 UTC).
# Set DISABLE_SCHEDULER=1 to turn the nightly job off entirely.
REFERRAL_SWEEP_HOUR_UTC=3
DISABLE_SCHEDULER=

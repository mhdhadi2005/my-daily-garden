PORT=3001
DB_PATH=./data/garden.db

# beehiiv (Settings → API)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_WEBHOOK_SECRET=

# Signs readers' garden passes. Its own secret (at least 32 characters), NOT the
# WordPress one. Without it passes stop working at every restart.
GARDEN_PASS_SECRET=

# WordPress plugin (paste the same value into Settings → My Daily Garden —
# generate a long random string, treat it like a password)
WP_APP_SHARED_SECRET=

# Bearer token for admin job endpoints (POST /api/jobs/referrals). Any long
# random string. Without it those endpoints stay disabled.
ADMIN_API_SECRET=

# Nightly referral sweep. Hour is UTC (default 3 = 03:00 UTC).
# Set DISABLE_SCHEDULER=1 to turn the nightly job off entirely.
REFERRAL_SWEEP_HOUR_UTC=3
DISABLE_SCHEDULER=

# Purchase points: only orders in this currency earn points (leave empty for any)
PURCHASE_CURRENCY=

# The garden's public address, used in each reader's personal garden link
# (defaults to the Railway domain)
PUBLIC_APP_URL=
